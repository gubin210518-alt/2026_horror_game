        "end": "timeup"
      },
      "@c2.again"
    ],
    "timeup": [
      {
        "picture": "assets/pics/sisters_blood_full.webp"
      },
      "@c2.timeup",
      {
        "picture": null
      },
      {
        "minigame": "painting",
        "puzzle": "m2",
        "image": "assets/pics/sisters_blood_full.webp",
        "must": true,
        "title": "@c2.timeupAsk",
        "cases": [
          [
            {
              "sfx": "laugh"
            },
            {
              "wait": 1.1
            },
            {
              "die": "@c2.chosen"
            }
          ],
          [
            {
              "sfx": "laugh"
            },
            {
              "wait": 1.1
            },
            {
              "die": "@c2.chosen"
            }
          ],
          [
            {
              "sfx": "laugh"
            },
            {
              "wait": 1.1
            },
            {
              "die": "@c2.chosen"
            }
          ],
          [
            {
              "sfx": "laugh"
            },
            {
              "wait": 1.1
            },
            {
              "die": "@c2.chosen"
            }
          ]
        ]
      }
    ],
    "look": [
      {
        "minigame": "painting",
        "puzzle": "m2",
        "title": "@c2.lookPrompt",
        "cases": [
          [
            {
              "set": "m2_pick",
              "to": 1
            },
            {
              "run": "pick"
            }
          ],
          [
            {
              "set": "m2_pick",
              "to": 2
            },
            {
              "run": "pick"
            }
          ],
          [
            {
              "set": "m2_pick",
              "to": 3
            },
            {
              "run": "pick"
            }
          ],
          [
            {
              "set": "m2_pick",
              "to": 4
            },
            {
              "run": "pick"
            }
          ]
        ]
      }
    ],
    "pick": [
      {
        "if": "has:paintknife",
        "then": [
          {
            "choice": [
              "물감칼로 찌른다",
              "그만둔다"
            ],
            "title": "@c2.stabAsk",
            "then": [
              [
                {
                  "run": "stabbed"
                }
              ],
              []
            ]
          }
        ],
        "else": [
          {
            "if": "m2_pick==1",
            "then": [
              "@c2.elena"
            ]
          },
          {
            "if": "m2_pick==2",
            "then": [
              "@c2.marie"
            ]
          },
          {
            "if": "m2_pick==3",
            "then": [
              "@c2.rose"
            ]
          },
          {
            "if": "m2_pick==4",
            "then": [
              "@c2.ines"
            ]
          }
        ]
      }
    ],
    "stabbed": [
      {
        "timerStop": 1
      },
      {
        "if": "m2_pick==4",
        "then": [
          {
            "picture": "assets/pics/sisters_4_dead.webp"
          },
          {
            "sfx": "scream"
          },
          {
            "scare": "#fff"
          },
          "@c2.success",
          {
            "picture": null
          },
          {
            "set": "m2_done"
          },
          {
            "puzzleDone": "m2"
          },
          {
            "sfx": "door"
          },
          {
            "goal": "비품실을 살펴본다"
          }
        ],
        "else": [
          {
            "if": "m2_pick==1",
            "then": [
              {
                "picture": "assets/pics/sisters_1_dead.webp"
              }
            ]
          },
          {
            "if": "m2_pick==2",
            "then": [
              {
                "picture": "assets/pics/sisters_2_dead.webp"
              }
            ]
          },
          {
            "if": "m2_pick==3",
            "then": [
              {
                "picture": "assets/pics/sisters_3_dead.webp"
              }
            ]
          },
          {
            "scare": "#a00"
          },
          "@c2.wrongLaugh",
          {
            "sfx": "laugh"
          },
          {
            "wait": 1.2
          },
          {
            "die": "@c2.wrong"
          }
        ]
      }
    ]
  },
