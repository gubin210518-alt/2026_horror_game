        {
          "scare": "#fff"
        },
        {
          "set": "m2_fled"
        },
        {
          "goal": "창가를 살펴본다"
        }
      ]
    }
  ],
  "events": {
    "intro": [
      {
        "picture": "assets/pics/sisters.webp",
        "zoom": true
      },
      "@c2.intro",
      {
        "picture": null
      },
      {
        "set": "m2_started"
      },
      {
        "puzzle": "m2"
      },
      {
        "note": "m2_lines"
      },
      {
        "goal": "거짓말쟁이를 찾아서 죽인다"
      },
      {
        "timer": 60,
        "label": "액자에 피가 차오른다",
