{
  "name": "비밀서고",
  "lit": true,
  "tiles": [
    "#####################",
    "#.........=.........#",
    "#.........=.........#",
    "#.........=.........#",
    "#.........=.........#",
    "#.........=.........#",
    "#.........=.........#",
    "#.........=.........#",
    "#####################"
  ],
  "onEnter": [
    {
      "if": "!m4_in",
      "then": [
        {
          "set": "m4_in"
        },
        "@c3.knock",
        {
          "note": "m4_note"
        },
        {
          "puzzle": "m4"
        },
        {
          "goal": "방을 윤하의 방과 마주보게 만든다"
        },
        "어지러운 방이다. 유리벽을 조사하면 윤하의 방을 살펴볼 수 있다."
      ]
    }
  ],
  "onPush": "check",
  "events": {
    "check": [
      {
        "set": "m4_n",
        "to": 0
      },
      {
        "if": "m4_books==1",
        "then": [
          {
            "add": "m4_n"
          }
        ]
      },
      {
        "if": "m4desk_x==3 & m4desk_y==4 & m4chair_x==3 & m4chair_y==5",
        "then": [
          {
            "add": "m4_n"
          }
        ]
      },
      {
        "if": "m4_lamp",
        "then": [
          {
            "add": "m4_n"
          }
        ]
      },
      {
        "if": "m4_cl & !m4_cr",
        "then": [
          {
            "add": "m4_n"
          }
        ]
      },
      {
        "if": "m4_clock==9",
        "then": [
          {
            "add": "m4_n"
          }
        ]
      },
      {
        "if": "m4_trash>=3",
        "then": [
          {
            "add": "m4_n"
          }
        ]
      }
    ],
    "report": [
      {
        "if": "m4_n>=6",
        "then": [
          {
            "if": "!m4_all",
            "then": [
              {
                "set": "m4_all"
              },
              "@c3.allSet"
            ],
            "else": [
              {
                "toast": "방은 모두 맞췄다. 남은 건 액자뿐이다."
              }
            ]
          }
        ],
        "else": [
          {
            "if": "m4_n>=1",
            "then": [
              {
                "toast": "유리 너머에서 윤하가 엄지를 척 든다. ({f:m4_n}/6)"
              }
            ]
          }
        ]
      }
    ]
  },
  "exits": [
    {
      "x": 1,
      "y": 0,
      "to": "library",
      "tx": 17,
      "ty": 1,
      "dir": "down",
      "if": "m4_done",
      "locked": "문이 열리지 않는다."
    }
  ],
